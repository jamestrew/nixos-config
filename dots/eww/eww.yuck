;; Include modular widget files
(include "widgets/common.yuck")
(include "widgets/bar-left.yuck")
(include "widgets/bar-right.yuck")
(include "widgets/control-center.yuck")

;; Use connector names so monitor discovery order cannot swap the bars.
;; bar0: ultrawide; bar1: 1080p
(defwindow bar0
  :monitor "DP-2" :geometry (geometry :x "0%"
                        :y "0%"
                        :width "100%"
                        :height "24px"
                        :anchor "top center")
  :stacking "fg"
  :layer "top"
  :exclusive true
  :namespace "eww-bar"
  (box :class "bar"
       :orientation "horizontal"
       :space-evenly false
    (bar-left :monitor "DP-2")
    (bar-right)))

(defwindow bar1
  :monitor "HDMI-A-1"
  :geometry (geometry :x "0%"
             :y "0%"
             :width "100%"
             :height "24px"
             :anchor "top center")
  :stacking "fg"
  :reserve (struts :distance "24px" :side "top")
  :windowtype "dock"
  :wm-ignore false
  :exclusive true
  (box :class "bar"
       :orientation "horizontal"
       :space-evenly false
    (bar-left :monitor "HDMI-A-1")
    (bar-right-slim)))




