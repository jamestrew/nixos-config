;; Left side widgets
(defwidget bar-left [monitor]
  (box :orientation "horizontal"
       :space-evenly false
       :halign "start"
       :hexpand true
    (workspaces :monitor monitor)
    (sep)))

(deflisten workspace-widgets-0 :initial "" "scripts/workspace-widget.sh DP-2")
(deflisten workspace-widgets-1 :initial "" "scripts/workspace-widget.sh HDMI-A-1")

(defwidget workspaces [monitor]
  (literal :content {monitor == "DP-2" ? workspace-widgets-0 : workspace-widgets-1}))

